{
  // The browser harness: e2e/ and playwright.config.ts. `npm run typecheck:e2e`.
  //
  // Deliberately NOT listed in tsconfig.json's references. `npm run build`
  // runs `tsc -b`, and that is what Vercel runs, so a reference here would let
  // a type error in a test spec stop the site deploying.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    // Specs import facts (titles, temperature bands, third-party hosts) from
    // src/ rather than restating them, and src/ imports with .ts extensions.
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["e2e", "playwright.config.ts"]
}
