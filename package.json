{
  "name": "world-hot-springs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "An open, curated atlas of the world's public hot springs.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "node --test \"scripts/**/*.test.mjs\"",
    "data:fetch": "node scripts/fetch-osm.mjs",
    "data:verify": "node scripts/fetch-osm.mjs --verify",
    "data:build": "node scripts/build-dataset.mjs",
    "data:all": "npm run data:fetch && npm run data:verify && npm run data:build"
  },
  "dependencies": {
    "maplibre-gl": "^5.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^26.3.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  }
}
