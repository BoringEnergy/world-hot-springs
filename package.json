{
  "name": "world-hot-springs",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "An open, curated atlas of the world's public hot springs.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run data:sitemap && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "node --test \"scripts/**/*.test.mjs\"",
    "data:fetch": "node scripts/fetch-osm.mjs",
    "data:verify": "node scripts/fetch-osm.mjs --verify",
    "validate": "node scripts/validate-overlay.mjs",
    "data:build": "node scripts/build-dataset.mjs && node scripts/build-citation.mjs",
    "data:ncei": "node scripts/fetch-ncei.mjs",
    "data:all": "npm run data:fetch && npm run data:verify && npm run data:build && npm run data:sitemap",
    "enrich": "node scripts/enrich.mjs",
    "enrich:plan": "node scripts/enrich.mjs --dry-run",
    "data:wqp": "node scripts/fetch-wqp.mjs",
    "data:nbmg": "node scripts/fetch-nbmg.mjs",
    "data:sitemap": "node scripts/build-sitemap.mjs",
    "release:meta": "node scripts/build-citation.mjs",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e --emptyOutDir",
    "preview:e2e": "vite preview --outDir dist-e2e --host 127.0.0.1 --port 4173 --strictPort",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps --only-shell chromium",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json"
  },
  "dependencies": {
    "maplibre-gl": "^5.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^26.3.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  }
}
