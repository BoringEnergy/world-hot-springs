node_modules/
dist/
.DS_Store
*.local
.env
.env.*

# Raw Overpass responses are large, refetchable, and not the deliverable.
# The curated output in data/hot-springs.* IS committed.
data/raw/

# Private exclusion list. Never committed, never published. See PRIVACY.md.
data/private/

# Build output
dist/

# Local provider selection. enrichment.config.example.json is the committed one.
enrichment.config.json

.vercel
.env*

# Per-tile cache for scripts/fetch-wqp.mjs. Makes a multi-hour fetch
# resumable; the MIRROR is the artefact, not the cache.
data/reference/.wqp-cache/

# Generated by `npm run data:sitemap`, which `npm run build` runs first. 1.3 MB
# of derived XML whose every line is a function of the dataset; committing it
# would mean a 7,490-line diff on every rebuild saying nothing the dataset does
# not already say.
public/sitemap.xml

# The browser harness (`npm run test:e2e`). The e2e build has its own output
# directory so the instrumented bundle can never be the one Vercel deploys;
# the rest is Playwright's reports, traces and browser cache.
dist-e2e/
playwright-report/
test-results/
blob-report/
playwright/.cache/

# Local session output. Never part of the project.
Claude outputs/
.gstack/
